# Copy to deploy.env and replace the example values.
# This is trusted shell configuration: keep it outside the public web root.
# Do not add spaces around = in variable assignments.

# Git repository containing the three applications and committed build files.
REPO_URL=git@github.com:YOUR_ORG/YOUR_REPO.git
BRANCH=main
REPO_DIR=/home/kcdf/deployment/repo

# Paths relative to the private Git checkout.
API_SOURCE=api-backend-php
ADMIN_SOURCE=kcdf-admin-app/dist/kcdf-admin-app/browser
MEMBER_SOURCE=kcdf-parents-app/www

# Existing HestiaCP document roots. Verify these on your VPS.
API_DEST=/home/kcdf/web/api.kcdfindia.com/public_html
ADMIN_DEST=/home/kcdf/web/admin.kcdfindia.com/public_html
MEMBER_DEST=/home/kcdf/web/YOUR_MEMBER_DOMAIN/public_html

# 1 = preview changes only; 0 = copy files to production.
DRY_RUN=1
