version: '3.8'
services:
  db:
    image: 'mariadb:10.6'
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: '${DB_ROOT_PASSWORD}'
    command:
      - '--character-set-server=utf8mb4'
      - '--collation-server=utf8mb4_unicode_ci'
      - '--innodb-read-only-compressed=OFF'
      - '--max-allowed-packet=256M'
      - '--lower-case-table-names=1'
      - '--innodb-buffer-pool-size=512M'
      - '--max-connections=50'
    volumes:
      - 'db-vol:/var/lib/mysql'
    healthcheck:
      test:
        - CMD
        - healthcheck.sh
        - '--connect'
        - '--innodb_initialized'
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    deploy:
      resources:
        limits:
          memory: 1000M
  redis-cache:
    image: 'redis:7-alpine'
    restart: unless-stopped
    command:
      - redis-server
      - '--appendonly'
      - 'no'
    volumes:
      - 'redis-cache-vol:/data'
    healthcheck:
      test:
        - CMD
        - redis-cli
        - ping
      interval: 10s
      timeout: 5s
      retries: 5
  redis-queue:
    image: 'redis:7-alpine'
    restart: unless-stopped
    command:
      - redis-server
      - '--appendonly'
      - 'yes'
    volumes:
      - 'redis-queue-vol:/data'
    healthcheck:
      test:
        - CMD
        - redis-cli
        - ping
      interval: 10s
      timeout: 5s
      retries: 5
  configurator:
    image: 'frappe/erpnext:version-15'
    restart: on-failure
    entrypoint:
      - bash
      - '-c'
    command:
      - "set -e; bench set-config -g db_host \"$$DB_HOST\"; bench set-config -gp db_port \"$$DB_PORT\"; bench set-config -g redis_cache \"redis://$$REDIS_CACHE\"; bench set-config -g redis_queue \"redis://$$REDIS_QUEUE\"; bench set-config -g redis_socketio \"redis://$$REDIS_QUEUE\"; bench set-config -gp socketio_port \"$$SOCKETIO_PORT\";\n"
    environment:
      DB_HOST: db
      DB_PORT: '3306'
      REDIS_CACHE: 'redis-cache:6379'
      REDIS_QUEUE: 'redis-queue:6379'
      SOCKETIO_PORT: '9000'
    volumes:
      - 'sites-vol:/home/frappe/frappe-bench/sites'
    depends_on:
      db:
        condition: service_healthy
      redis-cache:
        condition: service_healthy
      redis-queue:
        condition: service_healthy
  create-site:
    image: 'frappe/erpnext:version-15'
    restart: 'no'
    entrypoint:
      - bash
      - '-c'
    command:
      - >
        set -e;
        wait-for-it -t 180 db:3306;
        until
          [ -n "$$(grep -hs ^ sites/common_site_config.json | jq -r '.db_host // empty')" ] &&
          [ -n "$$(grep -hs ^ sites/common_site_config.json | jq -r '.redis_cache // empty')" ] &&
          [ -n "$$(grep -hs ^ sites/common_site_config.json | jq -r '.redis_queue // empty')" ];
        do
          echo "Waiting for common_site_config.json...";
          sleep 5;
        done;
        if [ -f "sites/$$SITE_NAME/site_config.json" ]; then
          echo "Site configuration already exists for $$SITE_NAME.";
          exit 0;
        fi;
        bench new-site --mariadb-user-host-login-scope='%' --db-root-username=root --db-root-password="$$DB_ROOT_PASSWORD" --admin-password="$$ADMIN_PASSWORD" --db-host="$$DB_HOST" --db-port="$$DB_PORT" --install-app erpnext --set-default "$$SITE_NAME";
    
    environment:
      SITE_NAME: '${SITE_NAME}'
      DB_HOST: db
      DB_PORT: '3306'
      DB_ROOT_PASSWORD: '${DB_ROOT_PASSWORD}'
      ADMIN_PASSWORD: '${ADMIN_PASSWORD}'
    volumes:
      - 'sites-vol:/home/frappe/frappe-bench/sites'
    depends_on:
      db:
        condition: service_healthy
      redis-cache:
        condition: service_healthy
      redis-queue:
        condition: service_healthy
      configurator:
        condition: service_completed_successfully
  backend:
    image: 'frappe/erpnext:version-15'
    restart: unless-stopped
    volumes:
      - 'sites-vol:/home/frappe/frappe-bench/sites'
    depends_on:
      - db
      - redis-cache
      - redis-queue
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8000"]
      interval: 15s
      timeout: 5s
      retries: 3
    deploy:
      resources:
        limits:
          memory: 1500M
  frontend:
    image: 'frappe/erpnext:version-15'
    restart: unless-stopped
    command:
      - nginx-entrypoint.sh
    environment:
      BACKEND: 'backend:8000'
      FRAPPE_SITE_NAME_HEADER: '${SITE_NAME}'
      SOCKETIO_SERVER: 'websocket:9000'
      UPSTREAM_REAL_IP_ADDRESS: 127.0.0.1
      UPSTREAM_REAL_IP_HEADER: X-Forwarded-For
      UPSTREAM_REAL_IP_RECURSIVE: 'off'
      PROXY_READ_TIMEOUT: '120'
      CLIENT_MAX_BODY_SIZE: 50m
    volumes:
      - 'sites-vol:/home/frappe/frappe-bench/sites'
    expose:
      - '8080'
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080"]
      interval: 15s
      timeout: 5s
      retries: 3
    depends_on:
      - backend
      - websocket
  websocket:
    image: 'frappe/erpnext:version-15'
    restart: unless-stopped
    command:
      - node
      - /home/frappe/frappe-bench/apps/frappe/socketio.js
    volumes:
      - 'sites-vol:/home/frappe/frappe-bench/sites'
    depends_on:
      - redis-queue
      - backend
  worker:
    image: 'frappe/erpnext:version-15'
    restart: unless-stopped
    command:
      - bench
      - worker
      - '--queue'
      - 'default,short,long'
    volumes:
      - 'sites-vol:/home/frappe/frappe-bench/sites'
    depends_on:
      - redis-queue
      - backend
  scheduler:
    image: 'frappe/erpnext:version-15'
    restart: unless-stopped
    command:
      - bench
      - schedule
    volumes:
      - 'sites-vol:/home/frappe/frappe-bench/sites'
    depends_on:
      - redis-queue
      - backend
volumes:
  db-vol: null
  sites-vol: null
  redis-cache-vol: null
  redis-queue-vol: null
